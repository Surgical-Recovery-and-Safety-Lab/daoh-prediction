                    "columns": [
                        "CATEGORY_LEVEL_1",
                        "CATEGORY_LEVEL_2"
                    ],
                    "target_type": "continuous",
                    "smooth": "auto"
                },
                {
                    "name": "StandardScaler",
                    "columns": [
