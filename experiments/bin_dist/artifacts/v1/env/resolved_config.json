{
    "meta": {
        "project_name": "custom",
        "run_mode": "cv",
        "verbose": "info"
    },
    "data": {
        "path": "/pvol/mroe734/data/NZ_data.v2.parquet",
        "predictors": [
            "AGE",
            "SEX",
            "PRIOR_CANCER",
            "ETHNICITY",
            "ASA",
            "ADMISSION_ACUITY",
            "ADMISSION_SOURCE",
